# ==============================================================================
# Foods66 Backend Environment Variables Template
# Copy this file to .env and supply your secrets.
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:3000

# MongoDB Connection String (REQUIRED - Server will fail to start if missing)
MONGODB_URI=mongodb://localhost:27017/foods66

# JWT Authentication Secret (REQUIRED - Server will fail to start if missing)
# Use a strong, random 256-bit secret in production
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key

# Google Gemini API Key (Optional - Fallbacks to local heuristics if not provided)
GEMINI_API_KEY=

# Stripe Payment Gateway Credentials (Optional - Uses simulated test mode if missing)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Redis Configuration (Optional - Background queues and caching disable gracefully if unreachable)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
