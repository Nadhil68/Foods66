# FOODS66 Production Environment Configuration Template
# DO NOT commit the actual .env.production file to version control.

# Server
NODE_ENV=production
PORT=5000
CLIENT_URL=https://<your-production-domain.com>

# Database
# Use your production MongoDB Atlas URI or self-hosted MongoDB URI
MONGODB_URI=mongodb+srv://<production-user>:<secure-password>@<cluster>.mongodb.net/foods66_prod?retryWrites=true&w=majority

# Security
# Generate a strong, random 64-character hex string
JWT_SECRET=<your-very-strong-production-jwt-secret>

# Third-Party APIs (Optional but recommended)
GEMINI_API_KEY=<your-production-gemini-api-key>

# Stripe Payments (If using real payments)
STRIPE_SECRET_KEY=<your-production-stripe-secret-key>
STRIPE_PUBLISHABLE_KEY=<your-production-stripe-publishable-key>
STRIPE_WEBHOOK_SECRET=<your-production-stripe-webhook-secret>
